# Copy to .env and fill in your own values. .env is gitignored.
# The Android app build reads only these two values:
REMOTE_API_BASE_URL=http://<tailscale-ip>:8081/
BRIDGE_TOKEN=

# The Ollama pure-chat URL is derived from REMOTE_API_BASE_URL by replacing its port
# with 11434; PURE_CHAT_BASE_URL is not consumed by the app.
# Cloud model keys belong on the bridge host only (see agent-bridge RELEASE.md),
# and CLI_MODEL belongs to cli/agent_cli.py — neither belongs in this file.
